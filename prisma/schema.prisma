generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("https://rxmrpyrtgkmjnxgfrxzo.supabase.co")
}

model User {
  id  string @id @default(cuid())
  name   string?
  email   string @unique
  password  string
}